# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Required for SyncWave authentication and real data persistence database.
# Find these in your Supabase project under Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
# Optional legacy fallback accepted for existing deployments.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-legacy-anon-key-here"

# Supabase Auth URL configuration:
# Add your production origin to Supabase Authentication -> URL Configuration.
# Example: https://syncwaveapp.vercel.app
# Also add the exact OAuth return URL used by the app, e.g.:
# https://syncwaveapp.vercel.app/dashboard
# Google OAuth itself must be enabled under Supabase Authentication -> Providers -> Google.

# TELEGRAM BOT INTEGRATION: Companion Remote Controller
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"



# Optional YouTube Data API key.
# When omitted, SyncWave uses YouTube oEmbed for basic metadata and the IFrame API for playback.
NEXT_PUBLIC_YOUTUBE_API_KEY="your-youtube-data-api-key"
